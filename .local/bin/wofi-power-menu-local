#!/usr/bin/bash

# --- Configuration ----------------------------------------------------------
# Format: "Display Name|Command"
MENU_DATA=(
  "Lock|swaylock -f"
  "Logout|swaymsg exit"
  "Suspend|swaylock -f && sleep 0.5 && systemctl suspend"
  "Reboot|systemctl reboot"
  "Power Off|systemctl poweroff"
)

# --- Internal Logic ---------------------------------------------------------
declare -A COMMAND_MAP
labels=()

for entry in "${MENU_DATA[@]}"; do
    IFS='|' read -r label command <<< "$entry"
    COMMAND_MAP["$label"]="$command"
    labels+=("$label")
done

# --- Execution --------------------------------------------------------------
choice=$(printf '%s\n' "${labels[@]}" | wofi -d --prompt "Power Menu" --width 400 --sort-order=alphabetical)

# Exit cleanly if nothing was selected (e.g. user pressed Escape)
if [[ -z "$choice" ]]; then
    exit 0
fi

# Execute the matching command, if any
if [[ -n "${COMMAND_MAP[$choice]}" ]]; then
    bash -c "${COMMAND_MAP[$choice]}"
fi
